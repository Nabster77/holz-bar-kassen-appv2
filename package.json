{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:catalog": "node scripts/run-catalog-transfer.mjs",
    "test:catalog-safety": "node scripts/check-catalog-safety.cjs",
    "test:catalog-sql": "node scripts/check-catalog-import-sql.mjs",
    "test": "npm run test:catalog && npm run test:catalog-safety && npm run test:catalog-sql && node scripts/check-cash-carry.cjs && node scripts/check-report-calculations.cjs && node --experimental-strip-types scripts/check-recovery-guards.mjs && node scripts/check-reset-safety.cjs && node --experimental-strip-types scripts/check-archive-paths.mjs && npm run test:storno && npm run test:device-setup && npm run test:storno-close && npm run test:storno-ledger && npm run test:storno-codec && npm run test:staff-proof && npm run test:session-linkage && npm run test:storno-sql-staging && npm run test:backup-sync-policy && npm run test:backup-archive && npm run test:backup-checkpoint && npm run test:final-close-ack && npm run test:pdf-local-only",
    "test:storno": "node --experimental-strip-types scripts/check-storno-rules.mjs",
    "test:device-setup": "node --experimental-strip-types scripts/check-device-setup.mjs",
    "test:storno-close": "node --experimental-strip-types scripts/check-storno-close-snapshot.mjs",
    "test:storno-ledger": "node --experimental-strip-types scripts/check-storno-ledger.mjs",
    "test:storno-codec": "node --experimental-strip-types scripts/check-storno-codec.mjs",
    "test:staff-proof": "node --experimental-strip-types scripts/check-storno-staff-proof.mjs",
    "test:session-linkage": "node --experimental-strip-types scripts/check-session-linkage.mjs",
    "test:storno-sql-staging": "node scripts/check-storno-sql-staging.mjs",
    "test:backup-sync-policy": "node --experimental-strip-types scripts/check-backup-sync-policy.mjs",
    "test:backup-archive": "node --import tsx scripts/check-backup-archive.mjs",
    "test:backup-checkpoint": "node --import tsx scripts/check-backup-checkpoint.mjs",
    "test:final-close-ack": "node --import tsx scripts/check-final-close-verification.mjs",
    "test:pdf-local-only": "node --experimental-strip-types scripts/check-local-pdf-policy.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.446.0",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
